      "css": ".ds-swatch{font-family:system-ui,'Noto Sans SC',sans-serif;width:104px;display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer;}.ds-swatch-frame{position:relative;width:100%;height:74px;padding:12px;border-radius:16px;background:#F1F4FD;border:2px solid #4A5CF5;}.ds-swatch-surface{position:absolute;inset:12px;border-radius:8px;background:#FCFDFF;border:1px solid #DCE2F2;padding:12px 8px;}.ds-swatch-bar{display:block;width:30px;height:5px;border-radius:3px;background:#4A5CF5;}.ds-swatch-bar.short{width:18px;height:4px;margin-top:5px;background:#6C63F2;}.ds-swatch-dot{position:absolute;right:10px;bottom:10px;width:8px;height:8px;border-radius:50%;background:#4A5CF5;}.ds-swatch-label{font-size:13px;font-weight:700;color:#4A5CF5;}"
