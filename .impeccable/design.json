      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item is-selected\" href=\"#\"><span class=\"ds-pill\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M4 4h6v7H4zM14 4h6v4h-6zM14 12h6v8h-6zM4 15h6v5H4z\"/></svg></span>总览</a><a class=\"ds-nav-item\" href=\"#\"><span class=\"ds-pill\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M4 8h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zM4 8V6a2 2 0 0 1 2-2h9l3 4\"/><circle cx=\"16\" cy=\"14\" r=\"1.4\"/></svg></span>持仓</a><a class=\"ds-nav-item\" href=\"#\"><span class=\"ds-pill\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></span>添加</a><a class=\"ds-nav-item\" href=\"#\"><span class=\"ds-pill\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M4 17l5-5 4 3 7-8\"/><path d=\"M15 7h5v5\"/></svg></span>分析</a><a class=\"ds-nav-item\" href=\"#\"><span class=\"ds-pill\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6l1.4 1.4m10 10l1.4 1.4m0-12.8l-1.4 1.4m-10 10l-1.4 1.4\"/></svg></span>设置</a></nav>",
      "css": ".ds-nav{font-family:system-ui,'Noto Sans SC',sans-serif;display:flex;height:68px;background:#FCFDFF;border-top:1px solid #DCE2F2;}.ds-nav-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;text-decoration:none;font-size:11.5px;font-weight:500;color:#555C73;}.ds-nav-item .ds-pill{width:56px;height:30px;border-radius:20px;display:grid;place-items:center;color:#555C73;transition:background 180ms cubic-bezier(0.215,0.61,0.355,1);}.ds-nav-item:hover .ds-pill{background:#E4E9F7;}.ds-nav-item.is-selected{color:#4A5CF5;font-weight:600;}.ds-nav-item.is-selected .ds-pill{background:#E0E5FF;color:#1C2560;}"
    },
